# ──────────────────────────────────────────────────────────────────────────────
# HuGuard AI – Environment Configuration
# Copy this file to .env and adjust values for your setup.
# ──────────────────────────────────────────────────────────────────────────────

# ── Ollama LLM ────────────────────────────────────────────────────────────────
# Host URL for Ollama (use host.docker.internal inside Docker)
OLLAMA_BASE_URL=http://localhost:11434

# Primary model for code analysis (must be pulled via: ollama pull qwen2.5-coder:7b)
OLLAMA_MODEL=qwen2.5-coder:7b

# Temperature for LLM responses (0.0 = deterministic, good for structured output)
OLLAMA_TEMPERATURE=0.1

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path for LangGraph checkpoint persistence
DATABASE_URL=/app/data/huguard.db

# ── API ───────────────────────────────────────────────────────────────────────
# FastAPI host/port (used inside the container)
API_HOST=0.0.0.0
API_PORT=8000

# CORS origins (comma-separated) – add your frontend URL
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Upload Limits ─────────────────────────────────────────────────────────────
# Maximum upload file size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# Directory for uploaded files (must be writable)
UPLOAD_DIR=/app/uploads

# ── LangGraph Agents ──────────────────────────────────────────────────────────
# Maximum critic retry cycles before aborting (prevents infinite loops)
MAX_PATCH_RETRIES=2

# Timeout per LLM call in seconds
LLM_TIMEOUT_SECONDS=120

# ── Logging ───────────────────────────────────────────────────────────────────
# Structured JSON logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Security ─────────────────────────────────────────────────────────────────
# Secret key for internal API integrity checks (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ── Frontend ──────────────────────────────────────────────────────────────────
# Public API base URL (exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
