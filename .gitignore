# HuGuard AI – Python gitignore patterns

# Virtual environments
venv/
.venv/
env/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Testing & Coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment
.env
!.env.example

# Docker
*.override.yml

# Data & uploads (runtime)
backend/app/data/
backend/uploads/
*.db
*.db-shm
*.db-wal

# Node / Next.js
node_modules/
.next/
frontend/.next/
frontend/out/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# OS
.DS_Store
Thumbs.db
*.log

# Secrets
*.pem
*.key
secrets/
